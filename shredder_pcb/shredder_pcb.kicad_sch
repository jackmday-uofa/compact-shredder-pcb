	(text "NOTE #?: THE FWD/STOP/REV SWITCH IS A THREE-POSITION SWITCH. WHEN IN THE\nFWD POSITION, STM_FWD IS DRAWN HIGH (CONNECTED TO +3V3). IN THE REV \nPOSITION, STM_REV IS DRAWN HIGH. IN THE STOP POSITION, NEITHER STM_FWD \nOR STM_REV ARE DRAWN HIGH--BOTH ARE PULLED LOW. "
		(exclude_from_sim no)
		(at 378.46 114.554 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
